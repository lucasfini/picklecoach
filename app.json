{
  "expo": {
    "name": "PickleCoach",
    "slug": "picklecoach",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "picklecoach",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucasfini.picklecoach"
    },
    "android": {
      "package": "com.lucasfini.picklecoach"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PickleCoach to use your camera to record practice videos.",
          "microphonePermission": "Allow PickleCoach to use your microphone while recording practice videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
